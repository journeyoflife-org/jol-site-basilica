# =============================================================================
# JOL Site Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — only .env.example is tracked.
# =============================================================================

# --- Next.js ---
# Canonical site origin. The localhost default is a NON-PRODUCTION fallback used
# by canonical/hreflang, robots.txt and sitemap.xml alike; never hardcode a real
# domain in source. Set per environment (deploy build-arg / repo variable):
#   production: https://basilica-vilnius-cathedral.gyvenimo-kelias.lt
#   demo:       https://demo-basilica.gyvenimo-kelias.lt
# Platform base domain is gyvenimo-kelias.lt (tenant-resolver TENANT_BASE_DOMAIN);
# the tenant subdomain is the fixture slug. katedra.lt is the institution's own
# site (content source / possible future VIP custom domain), not the platform host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Basilica of Vilnius Cathedral

# --- Tenant Resolution ---
# Set by middleware; override for local dev only
NEXT_PUBLIC_TENANT_SLUG=basilica
NEXT_PUBLIC_DEFAULT_LOCALE=lt

# --- Bitrix24 Auth (OIDC) ---
BITRIX24_DOMAIN=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# --- API ---
# Hub API endpoint (internal)
HUB_API_URL=http://localhost:8000
# Tenant-scoped API key (from hub admin)
TENANT_API_KEY=

# --- Sentry (error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics (consent-gated) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Feature Flags ---
# Enable test-mode payment events receiver (flag-gated, hub only)
NEXT_PUBLIC_PAYMENT_TEST_MODE=false

# --- Search indexing (build-time) ---
# Master switch for crawler indexing. Leave false/unset for demo, staging and
# pre-launch: the site then emits noindex/nofollow via metadata + X-Robots-Tag,
# serves Disallow: / in robots.txt and an empty sitemap. Set to true and REBUILD
# only after explicit release approval on the production domain.
ALLOW_INDEXING=false
