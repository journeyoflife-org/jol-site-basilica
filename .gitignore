# Vercel CLI deployment state and disposable tooling.
# .vercel/ holds the project/link id; .vercel-tmp/ holds a local CLI install
# and login logs. Neither belongs in the governed tree.
.vercel/
.vercel-tmp/

# Next.js auto-generated
next-env.d.ts
